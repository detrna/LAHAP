{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "start:worker": "node dist/worker.js",
        "dev": "tsx watch src/index.ts",
        "worker": "tsx src/worker.ts",
        "dev:worker": "tsx watch src/worker.ts",
        "test": "vitest --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.ts'",
        "test:run": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.ts'",
        "test:integration": "vitest run integration.test",
        "test:e2e": "vitest run e2e.test",
        "coverage": "vitest run --coverage --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.ts'",
        "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src",
        "format": "prettier --write --ignore-path ../.prettierignore --ignore-path .gitignore .",
        "format:check": "prettier --check --ignore-path ../.prettierignore --ignore-path .gitignore .",
        "postinstall": "prisma skills sync || exit 0",
        "contract:emit": "prisma contract emit",
        "seed": "tsx src/infrastructure/database/prisma/seed/main.ts"
    },
    "keywords": [],
    "type": "module",
    "engines": {
        "node": ">=26.8.2"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1159.0",
        "@aws-sdk/s3-request-presigner": "^3.1159.0",
        "@prisma/orm-postgres": "^8.0.0-rc.20",
        "bcrypt": "^6.0.0",
        "bullmq": "^6.5.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.5.0",
        "openai": "^7.45.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-pretty": "^13.2.0",
        "prisma": "^8.0.0-rc.27",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
