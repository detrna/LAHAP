{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["esnext"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "outDir": "dist"
    },
    "include": ["**/*.ts"]
}
