# App
PORT="4000"
IS_PRODUCTION="false"

# HTTP
CORS_ORIGINS="http://localhost:3000"
TRUST_PROXY="false"
UPLOAD_MAX_BYTES=5242880
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_COOKIE_NAME="lahap_refresh"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"
REALTIME_PING_INTERVAL_SECONDS=25
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_MAX_CONNECTIONS=1000

# Database
DB_URL="postgresql://user:password@localhost:5432/mydb"
DB_USER=user
DB_PASSWORD=password
DB_NAME=mydb
DB_PORT=5432

# JWT
JWT_SECRET="change-me-access"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ALGORITHM="HS256"
JWT_ISSUER="issuer"
JWT_AUDIENCE="audience"

# HASHER
BCRYPT_SALT_ROUNDS=10

# RECEIPT EXTRACTOR AI PROVIDER
RECEIPT_EXTRACTOR_API_KEY="change-me"
RECEIPT_EXTRACTOR_BASE_URL="https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1"
RECEIPT_EXTRACTOR_MODEL="qwen-vl-ocr-2025-11-20"
RECEIPT_EXTRACTOR_TIMEOUT_MS=30000
RECEIPT_EXTRACTOR_MAX_RETRIES=1

# STOCK LEVEL ESTIMATOR AI PROVIDER
STOCK_ESTIMATOR_API_KEY="change-me"
STOCK_ESTIMATOR_BASE_URL="https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1"
STOCK_ESTIMATOR_MODEL="qwen3.8-flash"
STOCK_ESTIMATOR_TOLERANCE=0.15
STOCK_ESTIMATOR_TIMEOUT_MS=30000
STOCK_ESTIMATOR_MAX_RETRIES=1

# OBJECT STORAGE
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY="change-me"
S3_SECRET_KEY="change-me"
S3_BUCKET="receipts"
S3_SIGNED_URL_EXPIRES_IN=3600
S3_TIMEOUT_MS=15000
S3_MAX_RETRIES=2

# PAYMENT GATEWAY
MIDTRANS_SERVER_KEY="change-me"
MIDTRANS_BASE_URL="https://app.sandbox.midtrans.com"
MIDTRANS_TIMEOUT_MS=15000
MIDTRANS_MAX_RETRIES=1

# REDIS
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
REDIS_KEY_PREFIX="gtnic:"
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=3

# SCHEDULER
SCHEDULER_TIMEZONE="Asia/Jakarta"
SCHEDULER_HEARTBEAT_CRON="* * * * *"

# LOGGER
LOG_LEVEL="info"
LOG_SERVICE_NAME="gtnic-backend"
LOG_FILE_PATH="log/log.txt"
LOG_PRETTY="true"

