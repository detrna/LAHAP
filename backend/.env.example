# App
PORT="3000"
IS_PRODUCTION="false"

# Database
DB_URL="postgresql://user:password@localhost:5432/mydb"
DB_USER=user
DB_PASSWORD=password
DB_NAME=mydb
DB_PORT=5432

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ALGORITHM="HS256"
JWT_ISSUER="issuer"
JWT_AUDIENCE="audience"

# HASHER
BCRYPT_SALT_ROUNDS=10

# RECEIPT EXTRACTOR
DASHSCOPE_API_KEY="change-me"
DASHSCOPE_BASE_URL="https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1"
DASHSCOPE_MODEL="qwen-vl-ocr-2025-11-20"
DASHSCOPE_TIMEOUT_MS=30000
DASHSCOPE_MAX_RETRIES=1

# OBJECT STORAGE
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY="change-me"
S3_SECRET_KEY="change-me"
S3_BUCKET="receipts"
S3_SIGNED_URL_EXPIRES_IN=3600
S3_TIMEOUT_MS=15000
S3_MAX_RETRIES=2

# PAYMENT GATEWAY
MIDTRANS_SERVER_KEY="change-me"
MIDTRANS_BASE_URL="https://app.sandbox.midtrans.com"
MIDTRANS_TIMEOUT_MS=15000
MIDTRANS_MAX_RETRIES=1

# REDIS
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
REDIS_KEY_PREFIX="gtnic:"
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=3

# SCHEDULER
SCHEDULER_TIMEZONE="Asia/Jakarta"
SCHEDULER_HEARTBEAT_CRON="* * * * *"
